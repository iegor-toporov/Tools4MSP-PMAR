# Copy to .env and fill in real values — never commit .env
# See: https://help.marine.copernicus.eu/en/articles/8185600

# Copernicus Marine Service credentials
COPERNICUSMARINE_SERVICE_USERNAME=your_copernicus_username
COPERNICUSMARINE_SERVICE_PASSWORD=your_copernicus_password

# Optional: override gunicorn worker count (default: 4)
# GUNICORN_WORKERS=4

# NB: HTTPS is handled by the Traefik reverse proxy in production, so no domain or
# certificate settings are needed here. BACKEND_URL is not read from this file either:
# docker-compose.yml sets it for the frontend (http://backend:5001).
