# Copy to .env and fill in real values — never commit .env
# See: https://help.marine.copernicus.eu/en/articles/8185600

# Copernicus Marine Service credentials
COPERNICUSMARINE_SERVICE_USERNAME=your_copernicus_username
COPERNICUSMARINE_SERVICE_PASSWORD=your_copernicus_password

# Optional: override gunicorn worker count (default: 4)
# GUNICORN_WORKERS=4

# Optional: demo mode (see README, "Demo mode"). Leave unset for normal use.
# With SIMULATION_TOKEN set, running simulations requires this token, and visitors
# only see the scenarios listed in PUBLIC_SCENARIOS (comma-separated ids).
# Generate a token with: openssl rand -hex 24
# SIMULATION_TOKEN=
# PUBLIC_SCENARIOS=custom_927fb7ae,custom_xxxxxxxx,custom_yyyyyyyy

# NB: HTTPS is handled by the Traefik reverse proxy in production, so no domain or
# certificate settings are needed here.
